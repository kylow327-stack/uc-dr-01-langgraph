# UC-DR-01 LangGraph demo. Fixtures only. No key is required to run.
# Copy to .env if you want optional tracing. Do not commit a real .env.

# Optional LangSmith tracing for the graph. Leave these commented and the
# demo stays local: no network and no API key. Install the extra with
#   pip install -e ".[trace]"
# before turning tracing on. v1 does not require LangSmith.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=uc-dr-01-langgraph
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Reserved for a later narrative model. v1 does not call a model, even if
# these are set. The score node never reads model output. Do not send real
# customer documents or live case folders.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21
